{
  "name": "wa-flashlogin-server",
  "version": "0.1.0",
  "type": "module",
  "description": "WhatsApp passwordless authentication server SDK with Baileys, webhook, and Meta Cloud API adapters",
  "author": "Kobus Wentzel",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "passwordless",
    "otp",
    "auth",
    "baileys",
    "authentication"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobie3717/wa-flashlogin.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/kobie3717/wa-flashlogin#readme",
  "bugs": "https://github.com/kobie3717/wa-flashlogin/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": "^6.0.0",
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "express": "^4.19.2",
    "supertest": "^7.2.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
