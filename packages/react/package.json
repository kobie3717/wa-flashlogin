{
  "name": "wa-flashlogin-react",
  "version": "0.1.0",
  "type": "module",
  "description": "React hooks and components for WhatsApp passwordless authentication",
  "author": "Kobus Wentzel",
  "license": "MIT",
  "keywords": [
    "react",
    "whatsapp",
    "passwordless",
    "auth",
    "hooks",
    "qrcode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobie3717/wa-flashlogin.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kobie3717/wa-flashlogin#readme",
  "bugs": "https://github.com/kobie3717/wa-flashlogin/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "happy-dom": "^14.7.1",
    "react": "^18.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
