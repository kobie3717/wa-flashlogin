{
  "name": "wa-flashlogin-vanilla",
  "version": "0.1.0",
  "type": "module",
  "description": "Vanilla JavaScript SDK for WhatsApp passwordless authentication with zero dependencies",
  "author": "Kobus Wentzel",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "passwordless",
    "vanilla",
    "javascript",
    "qrcode",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobie3717/wa-flashlogin.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://github.com/kobie3717/wa-flashlogin#readme",
  "bugs": "https://github.com/kobie3717/wa-flashlogin/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "happy-dom": "^14.7.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
